 "creation": "2021-12-21 14:22:23.837588",
 "css": "\nthead {display: table-header-group; }\ntfoot {display: none; }\n@media print {\n\n.print-format {\n\n  margin-left: 1mm;\nmargin-right: 1mm;\n\n\n\n\n\n}\n\n#footer-html{\ndisplay:block;\n\n\n}\n.page-footer{\nposition:fixed;\nbottom:0mm;\n\n}\nhtml{\npadding-bottom:0mm;\n}\nbody{\npadding-bottom:0mm;\n}\n\n}\n\n.print-format {\n\tpadding: 0in;\n  padding-bottom:0in;\ndirection: ltr;  \n}\n\n\n@media screen{\n\n.page-footer{display:none;}\n\n\n}\n\n\n#footer-html{\n font-family: 'verdana' !important;   \n}\n@page  \n{ \n    size: auto;   /* auto is the initial value */ \n\n    /* this affects the margin in the printer settings */ \n    margin: 0mm 0mm 0mm 0mm;  \n} \n",
 "custom_format": 1,
 "default_print_language": "ar",
 "disabled": 0,
 "doc_type": "Clearances",
 "docstatus": 0,
 "doctype": "Print Format",
 "font": "Default",
 "html": "<!DOCTYPE html>\n{% set type = doc.clearance_type %}\n{% if type =='Outgoing'%}\n    {% set sales_order = frappe.get_doc(\"Sales Order\",doc.sales_order) %}\n    {% set man = frappe.get_doc(\"Customer\",doc.customer) %}\n{% else %}\n    {% set sales_order = frappe.get_doc(\"Purchase Order\",doc.purchase_order) %}\n    {% set man = frappe.get_doc(\"Supplier\",doc.supplier) %}\n{% endif %}\n{% if type =='Outcomming'%}\n    {% set purchase_order = frappe.get_doc(\"Purchases Order\",doc.purchase_order) %}\n{% endif %}\n{% set comp = frappe.get_doc(\"Company\",doc.company) %}\n{% set company_name = comp.company_name %}\n{% set company_logo = comp.company_logo %}\n{% set color =  comp.color%}\n{% if comp.cr_number %} {% set cr = comp.cr_number | string %}{% endif %}\n      {% set cr_ar = cr | replace('0','\u0660') | replace('1','\u0661') | replace('2','\u0662') | replace('3','\u0663') | replace('4','\u0664') \n      | replace('5','\u0665') | replace('6','\u0666') | replace('7','\u0667') | replace('8','\u0668') | replace('9','\u0669') %}\n{% set company_arabic= comp.arabic_name %}\n{% set phone= comp.phone_no %}\n{% set links = frappe.get_all('Dynamic Link', \nfilters={'link_doctype': 'Company', 'link_name': doc.company, 'parenttype': 'Address'}, fields=['parent']) %}\n{% if links %}\n    {% set address = frappe.get_doc(\"Address\", links[0].parent) %}\n{% endif %} \n    \n    {% set currency =\"SAR\" %}\n\n\n      \n   {% set qrcode = getqrcode(doc.doctype,doc) %}\n    \n    \n    \n        <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Scheherazade+New&display=swap\" rel=\"stylesheet\">\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Scheherazade&display=swap\" rel=\"stylesheet\">\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Almarai&display=swap\" rel=\"stylesheet\">\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Almarai&family=Roboto:wght@500&display=swap\" rel=\"stylesheet\">\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Amiri:wght@700&display=swap\" rel=\"stylesheet\">\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fjalla+One&family=Teko:wght@300&display=swap\" rel=\"stylesheet\">\n\n\n<style>\n@font-face {\n    font-family: 'alarabiya';\n    src: url('https://arbfonts.com/font_files/new//Alarabiya%20Normal%20Font.ttf');\n}\n\n\n    table {\n        border-collapse: collapse;\n        \nborder: 1px solid black;\nborder-spacing: 0;\nborder-collapse:collapse;\nfont-size:20px;\n}\nth,td{\n    border-collapse: collapse;\n    font-family: 'Scheherazade', serif;font-size:12px;\nborder : 1px solid black;\n}\nth, td\n{\n    border-collapse: collapse;\nwidth:140px;\nline-height: 0.9;\nfont-family: 'Scheherazade', serif;font-size:12px;\npadding:0mm;\nmargin:0mm;\n}\n.ar{\n    text-align:right;\n    \n}\n    \n</style>\n<table class=\"items\" style=\"width:100%;border:none;\">\n    \n    <thead style=\"width:100%;border:none;\"> \n    <tr style=\"width:100%;border:none;\">\n        <td colspan=\"9\" style=\"width:100%;border:none;\"> <div style=\"height:120px;width:100%;\">\n            {% if not no_letterhead %}\n            <table style=\"width:100%;border:none;\">\n              <tr style=\"border:none;\">\n                  <td rowspan=\"2\" style=\"border:none;width:17%;text-align:center;\">\n                  {% if company_logo %} <img  src=\"{{company_logo}}\" style=\"width:auto;height:90px;\" /> {% endif %}\n                </td>\n                <td style=\"border:none;text-align:center;color:{{color}};width:47%;\">\n                    <span style=\"color:{{color}};font-size:25px;font-family:alarabiya;\">{{company_arabic}}</span><br>\n                    <span style=\"color:{{color}};font-size:18px;font-family:alarabiya;\">\u0623\u0646\u0638\u0645\u0629 \u0627\u0644\u062d\u0645\u0627\u064a\u0629 \u0645\u0646 \u0627\u0644\u062d\u0631\u064a\u0642</span><br>\n                    <span style=\"color:{{color}};font-size:19px;font-family: 'Fjalla One', cursive;line-height:1.2;font-weight:500;\">{{company_name}}</span><br>\n                    <span style=\"color:{{color}};font-size:14px;font-family:'Fjalla One';\">FIRE PROTECTION SYSTEMS</span><br>\n                    <span style=\"color:#4013aa;font-family: 'Scheherazade', serif;font-size:15px;\">\u0634\u0631\u0643\u0629 \u0630\u0627\u062a \u0645\u0633\u0624\u0644\u064a\u0629 \u0645\u062d\u062f\u0648\u062f\u0629 \u0628\u0631\u0623\u0633 \u0645\u0627\u0644 \u0645\u062f\u0641\u0648\u0639 500,000 \u0631\u064a\u0627\u0644</span>\n                </td>\n                <td style=\"border:none;\"></td>\n               </tr>\n           </table>\n            {% endif %}\n            \n            \n        </div></td>\n      \n        \n    </tr>\n    </thead>\n    \n   <tr style=\"border:none;\"><td colspan=\"9\" style=\"border:none;\">\n   \n   <div style=\"text-align:center;width:100%;margin-top:-10px;\">\n    <span style=\"font-family: 'roboto', serif;font-size:25px;color:black;line-height:0.5;\">Clearance</span>\n<span id=\"fatoura\" style=\"font-family: 'Amiri', cursive;font-size:27px;line-height:1.9;color:black;line-height:0.5;\">\u0645\u0633\u062a\u062e\u0644\u0635 \u0623\u0639\u0645\u0627\u0644</span>  <br>\n\n<span style=\"font-family: 'roboto', serif;font-size:15px;color:black;margin-top:-10px;\">Tax Invoice</span>\n<span id=\"fatoura\" style=\"font-family: 'Amiri', cursive;font-size:17px;line-height:1.9;color:black;\">\u0641\u0627\u062a\u0648\u0631\u0629 \u0636\u0631\u064a\u0628\u064a\u0629</span>  <br>\n\n<span style=\"color:black;\"> VAT No.:</span><span style=\"color:black;font-family:arial;\"> {{comp.tax_id or ''}}</span> :<span style=\"color:black;font-family: 'Lateef', cursive;\">\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0636\u0631\u064a\u0628\u064a</span>\n\n</div>\n<table style=\"width:102%;border:none;;margin-top:-5px;margin-left:-6px;margin-right:-3px;\">\n    <tr>\n        <td style=\"width:47%;border:none;\">\n            <div style=\"width:110px;height:110px;margin-left:25%;margin-bottom:10px;margin-top:-33px;\">\n               \n            {% set n = testbaaa(\"Clearances\",doc.name) | replace(\"&\",\"%26\")  %}   \n\n            {% if doc.docstatus ==2 %}<br>\n                <span style=\"color:{{color}};font-family:'Amiri',cursive ;font-size:24px;line-height:1.3;\"><br> \u0641\u0627\u062a\u0648\u0631\u0629 \u0645\u0644\u063a\u064a\u0629 </span>\n            {% elif doc.docstatus ==0%}<br>\n               <span style=\"color:{{color}};font-family:'Amiri',cursive ;font-size:24px;line-height:1.3;\"><br> \u0641\u0627\u062a\u0648\u0631\u0629 \u0645\u0633\u0648\u062f\u0629 </span>\n            {% else %}\n  <img src=\"https://api.qrserver.com/v1/create-qr-code/?size=160x160&color={{color[1:]}}&data={{qrcode}}\"  alt=\"\" width:\"10\" height:\"100\" />{% endif %}\n</div>\n            <table class=\"t1 listdb\" style=\"height:100%;\">\n<tr style=\" height:10px;\">\n    <td style=\"font-family: 'Scheherazade', serif;font-size:15px;\"><b>Invoice Number:</b></td>\n    <td style=\"font-family: 'Scheherazade', serif;font-size:15px;text-align:center;width:43%;\">{{doc.name}}</td>\n    <td class=\"ar\" style=\"font-family: 'Scheherazade', serif;font-size:15px;width:25%;\"><b>\u0631\u0642\u0645 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629</b></td>\n  </tr>\n\n<tr>\n    <td style=\"font-family: 'Scheherazade', serif;font-size:15px;\" ><b>Invoice Issue Date:</b></td>\n    <td style=\"font-family: 'Scheherazade', serif;font-size:15px;text-align:center;\" >{{doc.clearance_date or ''}}</td>\n    <td class=\"ar\" style=\"font-family: 'Scheherazade', serif;font-size:15px;\" ><b>\u062a\u0627\u0631\u064a\u062e \u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629</b></td>\n</tr> \n<tr>\n    <td style=\"font-family: 'Scheherazade', serif;font-size:15px;\" ><b>Due Date:</b></td>\n    <td style=\"font-family: 'Scheherazade', serif;font-size:15px;text-align:center;\" >{{doc.due_date or ''}}</td>\n    <td class=\"ar\" style=\"font-family: 'Scheherazade', serif;font-size:15px;\" ><b>\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0633\u062a\u062d\u0642\u0627\u0642</b></td>\n</tr>\n\n\n</table>\n        </td>\n        <td style=\"border:none;\">\n<table id=\"big\" style=\"width:100%;height:100%;margin-top:10px;\">\n\n\n<tr >\n\n\t<td colspan=\"2\" style=\"width:30%;font-family: 'Scheherazade', serif;font-size:15px;\" ><b>Customer name</b></td>\n\t<td colspan=\"2\"  style=\"line-height:0.8;text-align:center;font-family: 'Scheherazade', serif;font-size:15px;\">{{man.name}}</td>\n\n\t<td  colspan=\"2\"  class=\"ar\" style=\"font-family: 'Scheherazade', serif;font-size:15px;width:20%;\" > <b>\u0625\u0633\u0645 \u0627\u0644\u0639\u0645\u064a\u0644 </b></td>\n</tr>\n<tr>\n\n\t<td colspan=\"2\" style=\"font-family: 'Scheherazade', serif;font-size:15px;\"><b>Address</b></td>\n\t<td colspan=\"2\" style=\"line-height:0.8;text-align:center;font-family: 'Scheherazade', serif;font-size:15px;\">{% if addr %}{{addr.address_line1[:30]}} {% endif %}</td>\n\t\n\t<td colspan=\"2\"  class=\"ar\" style=\"font-family: 'Scheherazade', serif;font-size:15px;\"><b>\u0627\u0644\u0639\u0646\u0648\u0627\u0646</b></td>\n</tr>\n\n<tr>\n\n\t<td colspan=\"2\" style=\"font-family: 'Scheherazade', serif;font-size:15px;\" ><b>VAT No:</b></td>\n\t<td colspan=\"2\"  style=\"text-align:center;font-family: 'Scheherazade', serif;font-size:15px;\">{{ man.tax_id or '' }}</td>\n\t\n\t<td colspan=\"2\"  class=\"ar\"  style= \"line-height: 0.9;font-family: 'Scheherazade', serif;font-size:15px;\"><b>\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0636\u0631\u064a\u0628\u064a</b></td>\n</tr>\n<tr>\n\n\t<td colspan=\"2\"  style=\"line-height:0.8;font-family: 'Scheherazade', serif;font-size:15px;\"><b>Contact</b></td>\n\t<td colspan=\"2\"  style=\"line-height:0.8;text-align:center;font-family: 'Scheherazade', serif;font-size:15px;\">{{man.contact or ''}}</td>\n\n\t<td colspan=\"2\"  class=\"ar\" style=\"line-height:0.8;font-family: 'Scheherazade', serif;font-size:15px;\"><b>\u0627\u0644\u062a\u0648\u0627\u0635\u0644</b></td>\n</tr>\n<tr>\n    <td colspan=\"2\" style=\"font-family: 'Scheherazade', serif;font-size:15px;\" ><b>{% if sales_order %}S{% else %}P{% endif %}.O Number</b></td>\n    <td colspan=\"2\" style=\"font-family: 'Scheherazade', serif;font-size:15px;text-align:center;\" >{% if sales_order %}{{sales_order.name}}{% else %}{{purchase_order.name}}{% endif %}</td>\n    <td  colspan=\"2\" class=\"ar\" style=\"font-family: 'Scheherazade', serif;font-size:15px;\" ><b>{% if sales_order %}\u0623\u0645\u0631 \u0627\u0644\u0628\u064a\u0639{% else %}\u0623\u0645\u0631 \u0627\u0644\u0634\u0631\u0627\u0621{% endif %}</b></td>\n</tr>\n<tr>\n    <td colspan=\"2\" style=\"font-family: 'Scheherazade', serif;font-size:15px;\" ><b>Sale Person</b></td>\n    <td colspan=\"2\" style=\"font-family: 'Scheherazade', serif;font-size:15px;text-align:center;\" ></td>\n    <td colspan=\"2\" class=\"ar\" style=\"font-family: 'Scheherazade', serif;font-size:15px;\" ><b>\u0627\u0644\u0645\u0646\u062f\u0648\u0628</b></td>\n</tr>\n</table>\n\n</td>\n</tr>\n</table>\n </td></tr>\n   <tr style=\"border:none;\"> <td colspan=\"9\" style=\"border:none;\"> <table style=\"border:none;\"> \n\n    <tr style=\"background-color:{{color}};border-bottom:none;\">\n        <td colspan=\"5\" style=\"text-align:left;color:white;border-right:none;font-size:15px;border-bottom:none;font-weight:bold;\">Line Items:</td>\n        <td colspan=\"4\" style=\"line-height:0.8;border-left:none;text-align:right;color:white;font-family: 'Scheherazade', serif;font-size:21px;border-bottom:none;font-weight:bold;\">\u062a\u0648\u0635\u064a\u0641 \u0627\u0644\u0633\u0644\u0639\u0629 \u0623\u0648 \u0627\u0644\u062e\u062f\u0645\u0629 </td>\n    </tr>\n    <tr style=\"font-weight:bold;text-align:center;\" class=\"trr\" >\n        <td style=\"width:2%;font-size:12px;line-height:1.8;\"> <span id=\"SN\">S.N</span><br><span>\u0631.\u062a</span></td>\n        <td style=\"line-height:1.8;font-size:12px;\"> <span>Nature of goods or services</span><br> <span style=\"font-family: 'Scheherazade', serif;font-size:15px;\">\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0633\u0644\u0639 \u0648\u0627\u0644\u062e\u062f\u0645\u0627\u062a </span></td>\n        <td style=\"width:13%;line-height:1.5;text-align:center;font-size:12px;\"> <span>Unit price</span><br> <span style=\"font-family: 'Scheherazade', serif;font-size:15px;\">\u0633\u0639\u0631 \u0627\u0644\u0648\u062d\u062f\u0629</span> <span><br>({{currency}})</span></td>\n         <td style=\"line-height:1.8;text_align:center;width:8%;font-size:12px;display: table-cell;vertical-align: middle;\"> <span>Quantity</span><br> <span style=\"font-family: 'Scheherazade', serif;font-size:15px;\">\u0627\u0644\u0643\u0645\u064a\u0629</span></td>\n          <td style=\"line-height:1.5;text_align:center;width:12%;font-size:12px;\"> <span>Total Amount</span><br> <span style=\"font-family: 'Scheherazade', serif;font-size:15px;\">\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0627\u062c\u0645\u0627\u0644\u064a</span></td>\n        <td style=\"text_align:center;line-height:1.5;width:10%;font-size:12px;\"> <span>Current Quantity</span><br> <span style=\"font-family: 'Scheherazade', serif;font-size:15px;\">\u0627\u0644\u0643\u0645\u064a\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629</span></td>\n       \n       \n        <td style=\"text_align:center;line-height:1.5;width:12%;font-size:12px;\"> <span>Current Amount</span><br> <span style=\"font-family: 'Scheherazade', serif;font-size:15px;\">\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u062d\u0627\u0644\u064a</span></td>\n      \n    </tr>\n    \n    {% set total_discount=[0]%}\n    {% set total=[0]%}    \n    {% set i=[1]%}   \n    {% for item in doc.items %}\n    \n    \n    \n  \n     <tr>\n        <td style=\"width:2%;\" > {{i[0]}}</td>\n          <td style=\"line-height:1;font-family: 'Scheherazade', serif;font-size:15px;\">{{item.item_name[:38]}}</td>\n        <td class=\"ar\" style=\"font-family: 'Scheherazade', serif;font-size:15px; vertical-align: middle;\">{{\"{:,.2f}\".format(item.rate)}}</td>\n        <td class=\"ar\" style=\"font-family: 'Scheherazade', serif;font-size:15px;\">{{item.qty}}</td>\n        <td class=\"ar\" style=\"font-family: 'Scheherazade', serif;font-size:15px;\">{{\"{:,.2f}\".format(item.amount)}}</td>\n          <!--{% if item.discount_percentage %}{% if item.discount_percentage %1 ==0 %}{{item.discount_percentage |int }}{% else %}{{ \"{:,.2f}\".format(item.discount_percentage)}}{% endif %}{% else %}{% if item.discount_amount %}{% set per = ((item.discount_amount*100/item.price_list_rate) | float) %}{% if per %1 ==0 %}{{per |int }}{% else %}{{ \"{:,.2f}\".format(per)}}{% endif %}{% else %}0{% endif %}{% endif%}% -->\n        <td class=\"ar\" style=\"font-family: 'Scheherazade', serif;font-size:15px;\">{{item.current_qty}}</td>\n        \n        <td class=\"ar\" style=\"font-family: 'Scheherazade', serif;font-size:15px;\">{{\"{:,.2f}\".format(item.current_amount)}}</td>\n        \n    </tr>\n    {% if i.append(i.pop()+1) -%}{% endif %}\n    {% endfor %}\n   </table></td></tr>\n   <tr style=\"border:none;\"><td style=\"border:none;\" colspan=9><table style=\"width:100%;\">\n       <tr>\n        \n        <td style=\"font-family: 'Scheherazade', serif;font-size:15px;\"><b>Gross</b></td>\n        <td  style=\"text-align:center;font-family:arial;\"> {{ \"{:,.2f}\".format(doc.gross)  }} {{currency}}</td>\n       \n        <td  class=\"ar\" style=\"font-family: 'Scheherazade', serif;font-size:15px;\"><b>\u0627\u0644\u0645\u062c\u0645\u0648\u0639</b></td>\n         </tr>\n         <tr>\n        \n        <td  style=\"font-family: 'Scheherazade', serif;font-size:15px;\"><b>Advance payment recovery </b></td>\n        <td  style=\"text-align:center;font-family:arial;\"> {{ \"{:,.2f}\".format(doc.advanced_payment_insurance_amount)  }} {{currency}}</td>\n       \n        <td  class=\"ar\" style=\"font-family: 'Scheherazade', serif;font-size:15px;\"><b>\u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0627\u0644\u062f\u0641\u0639\u0629 \u0627\u0644\u0645\u0642\u062f\u0645\u0629 </b></td>\n         </tr>\n         <tr>\n        \n        <td  style=\"font-family: 'Scheherazade', serif;font-size:15px;\"><b>Total amount before VAT</b></td>\n        <td  style=\"text-align:center;font-family:arial;\"> {{ \"{:,.2f}\".format(doc.total_amount_before_vat)  }} {{currency}}</td>\n       \n        <td  class=\"ar\" style=\"font-family: 'Scheherazade', serif;font-size:15px;\"><b>(\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u062e\u0627\u0636\u0639 \u0644\u0644\u0636\u0631\u064a\u0628\u0629 ( \u063a\u064a\u0631 \u0634\u0627\u0645\u0644\u0629 \u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629</b></td>\n         </tr>\n         <tr>\n       \n        <td colspan=\"1\" style=\"font-family: 'Scheherazade', serif;font-size:15px;\"><b>Total VAT</b></td>\n        <td colspan=\"1\" style=\"text-align:center;font-family:arial;\">{{ \"{:,.2f}\".format(doc.vat) }} {{currency}}</td>\n        <td colspan=\"1\" class=\"ar\" style=\"font-family: 'Scheherazade', serif;font-size:15px;\"><b>\u0645\u062c\u0645\u0648\u0639 \u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629</b></td>\n        \n        \n    </tr>\n    <tr>\n       \n        <td colspan=\"1\" style=\"font-family: 'Scheherazade', serif;font-size:15px;\"><b>Retention</b></td>\n        <td colspan=\"1\" style=\"text-align:center;font-family:arial\">{{ \"{:,.2f}\".format(doc.initial_delivery_payment_insurance_amount) }} {{currency}}</td>\n        <td colspan=\"1\" class=\"ar\" style=\"font-family: 'Scheherazade', serif;font-size:15px;\"><b>\u0627\u062d\u062a\u0641\u0627\u0638</b></td>\n     </tr>\n    <tr>\n       \n        <td colspan=\"1\" style=\"font-family: 'Scheherazade', serif;font-size:15px;\"><b>Net amount</b></td>\n        <td colspan=\"1\" style=\"text-align:center;font-family:arial;\">{{ \"{:,.2f}\".format(doc.net_amount) }} {{currency}}</td>\n        <td colspan=\"1\" class=\"ar\" style=\"font-family: 'Scheherazade', serif;font-size:15px;\"><b>\u0635\u0627\u0641\u064a \u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u0633\u062a\u062d\u0642 </b></td>\n     </tr>\n       \n   </table></td></tr>\n   \n   \n  \n   \n   \n   \n     <tfoot style=\"width:100%;margin-bottom:100px;\" id=\"feet\">\n    <tr style=\"border:none;width:100%;\" class=\"trr\" >\n        <td style=\"width:100%;border:none;\" colspan=\"9\"> <div style=\"height:100px;\">\n            <div class=\"foot\" style=\"text-align:center;margin-top:5px;\" >\n           \n        \n</div>\n            \n            \n            </div></td>\n       \n    </tr>\n    </tfoot>\n    \n  \n</table>\n\n    \n\n\n{% if not no_letterhead %}\n  <div class=\"page-footer\" style=\"text-align:center;height:100px;position:fixed;bottom:0mm;right:5mm;left:5mm;z-index=9999;\" id =\"footer-html\">\n     \n    <div id=\"htmlfooter\" style=\"width:100%;\">\n         \n       <div class=\"foot\" style=\"text-align:center;margin-top:0px;width:100%;\" >\n           \n         <table style=\"width:100%;border:none;\">\n             <tr style=\"width:100%;border:none;\">\n                 <td style=\"line-height:1.2;border:none;\"><span style=\"float:left;color:{{color}};\">Headquarter - {{address.city or ''}}</span><br>\n                     <span style=\"float:left;color:{{color}};\">P.O.Box 4788 -{{address.city or ''}} {{address.pincode or ''}}</span><br>\n                     <span style=\"float:left;color:{{color}};\">{{address.address_line1 or ''}}</span><br>\n                     <span style=\"float:left;color:{{color}};\">Tel.: {{phone or ''}}</span><br>\n                     <span style=\"float:left;color:{{color}};\">Fax: {{comp.fax or ''}}</span><br>\n                     <span style=\"float:left;color:{{color}};\">{{address.country or ''}}</span>\n                 </td>\n                 <td style=\"width:40%;border:none;text-align:center;\">\n                     <div style=\"margin-top:40px;\">\n                     <p class=\" page-number visible-pdf\" style=\"font-size:13px;\">\n                {{ _(\"<b> {0}-{1} </b>\").format('<span class=\"page\"></span>', '<span class=\"topage\"></span>') }}\n            </p></div>\n                     {% if comp.website  %}\n                     <div style=\"background-color:{{color}};height:22px;padding-top:3px;margin-top:10px;\"><span style=\"color:white;line-height:1.4;font-weight:bold;\">{{comp.website}}</span></div>\n                     {% endif %}\n                     \n                     \n                 </td>\n                 \n                 {% if address.pincode %}\n                 {% set pin = address.pincode | replace('0','\u0660') | replace('1','\u0661') | replace('2','\u0662') | replace('3','\u0663') | replace('4','\u0664') \n      | replace('5','\u0665') | replace('6','\u0666') | replace('7','\u0667') | replace('8','\u0668') | replace('9','\u0669') %}\n                 {% endif%}\n                 {% if phone %}\n                 {% set phonear = phone | replace('0','\u0660') | replace('1','\u0661') | replace('2','\u0662') | replace('3','\u0663') | replace('4','\u0664') \n      | replace('5','\u0665') | replace('6','\u0666') | replace('7','\u0667') | replace('8','\u0668') | replace('9','\u0669') | replace('+','') %}\n                 {% endif%}\n                 {% if comp.fax%}\n                 {% set faxar = comp.fax | replace('0','\u0660') | replace('1','\u0661') | replace('2','\u0662') | replace('3','\u0663') | replace('4','\u0664') \n      | replace('5','\u0665') | replace('6','\u0666') | replace('7','\u0667') | replace('8','\u0668') | replace('9','\u0669') | replace('+','') %}\n                 {% endif%}\n                 {% if comp.fax%}\n                 {% endif %}\n                 \n                 \n                 \n                 {% set pa = phonear.split(\"-\")%}\n                 {% set fa = faxar.split(\"-\")%}\n                 \n                 <td style=\"line-height:1.2;color:{{color}};border:none;font-family: 'Scheherazade', serif; direction:rtl;\">\n                     \n                     <span style=\"float:right;color:{{color}};font-family: helvetica, serif;\">\u0627\u0644\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 - {{address.arabic_town or ''}}</span><br>\n                     <span style=\"float:right;color:{{color}};\">\u0633.\u0628 \u0664\u0667\u0668\u0668-\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0628\u0631\u064a\u062f\u064a  {{pin or  ''}}</span><br>\n                     <span style=\"float:right;color:{{color}};\">{{address.address_line2 or ''}}</span><br>\n                     <span style=\"float:right;color:{{color}};font-family:arial;direction:rtl;\">\u0647\u0627\u062a\u0641 :{{pa[-1]}} {% for p in pa[-2:0:-1] %}{{p}} {% endfor %}{{pa[0]}}+</span><br>\n                     <span style=\"float:right;color:{{color}};\">\u0641\u0627\u0643\u0633:{{fa[-1]}} {% for f in fa[-2:0:-1] %}{{f}} {% endfor %}{{fa[0]}}+</span><br>\n                     <span style=\"float:right;color:{{color}};\">{{address.county or ''}}</span>\n                 </td>\n                 \n             </tr>\n             \n             \n         </table>\n         \n        \n</div>\n    </div>\n    \n  </div>\n  \n  {% endif %}\n    <script>\n     document.getElementById(\"feet\").style.display=\" table-footer-group\";\n      \n      \n  </script>\n",
